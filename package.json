{
  "name": "esfera-editor",
  "version": "0.2.0-preview.1",
  "license": "MIT",
  "private": true,
  "description": "Editor local de panoramas 360",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check lib/model-manager.cjs && python3 -m py_compile guided.py stamps.py processing.py && npm test",
    "test": "node --test test/*.test.mjs",
    "setup:native": "sh scripts/setup-native.sh",
    "setup:python": "sh scripts/setup-python.sh",
    "setup:lama": "sh scripts/setup-lama.sh",
    "build:mac": "node scripts/build-mac.cjs",
    "icons": "node scripts/build-icons.cjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "electron": "^42.11.18"
  },
  "build": {
    "appId": "io.github.eseperio.esfera",
    "productName": "Esfera",
    "copyright": "MIT \u2014 Esfera contributors",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "lib/**/*",
      "assets/icon.png",
      "models/lama-manifest.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "runtime/python"
      },
      {
        "from": "native",
        "to": "runtime/native",
        "filter": [
          "lama-runner",
          "subject-mask",
          "ERASE-MIT-LICENSE.txt"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "build/licenses",
        "to": "licenses/python"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.photography",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "Esfera-${version}-macOS-${arch}.${ext}"
  },
  "author": "Esfera contributors"
}
