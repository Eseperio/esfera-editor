{
  "name": "esfera-editor",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Editor local de panoramas 360",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && python3 -m py_compile guided.py stamps.py && npm test",
    "test": "node --test test/*.test.mjs",
    "setup:native": "sh scripts/setup-native.sh",
    "setup:python": "sh scripts/setup-python.sh",
    "setup:lama": "sh scripts/setup-lama.sh"
  },
  "dependencies": {
    "electron": "^42.11.18",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
